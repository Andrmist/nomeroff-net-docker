{
    "swagger": "2.0",
    "info": {
        "description": "Numberplates recognition REST API",
        "title": "AutomotoAPI | WestAutoHub",
        "contact": {
            "name": "Automoto",
            "url": "https://automoto.ua",
            "email": "info@automoto.ua"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api",
    "paths": {
        "/oauth/token": {
            "post": {
                "description": "Get [OAuth 2.0](https://www.rfc-editor.org/rfc/rfc6749.html) Authorization Token. There are two options for passing OAuth 2.0 credentials: Authorization header or x-www-form-urlencoded data",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "est"
                ],
                "summary": "Get OAuth 2.0 Authorization Token",
                "parameters": [
                    {
                        "type": "string",
                        "name": "client_id",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "name": "client_secret",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "default": "client_credentials",
                        "name": "grant_type",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "client_id:client_secret in base64",
                        "name": "Authorization",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Returns auth token and TTL",
                        "schema": {
                            "$ref": "#/definitions/handlers.GetTokenResponce"
                        }
                    },
                    "400": {
                        "description": "Request data is invalid",
                        "schema": {
                            "$ref": "#/definitions/utils.Http"
                        }
                    },
                    "422": {
                        "description": "Server cannot process request data",
                        "schema": {
                            "$ref": "#/definitions/utils.Http"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/utils.Http"
                        }
                    }
                }
            }
        },
        "/v1/numberplate": {
            "post": {
                "description": "Get numberplates array from photo file",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "est"
                ],
                "summary": "Find numberplates on photo",
                "parameters": [
                    {
                        "type": "file",
                        "description": "Numberplate photo to check",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "default": "Bearer \u003cAdd auth token here\u003e",
                        "description": "OAuth 2.0 Authorization token",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Returns numberplates array",
                        "schema": {
                            "$ref": "#/definitions/handlers.ProcessPhotoResponce"
                        }
                    },
                    "400": {
                        "description": "Request data is invalid",
                        "schema": {
                            "$ref": "#/definitions/utils.Http"
                        }
                    },
                    "401": {
                        "description": "Authorize token is invalid or expired",
                        "schema": {
                            "$ref": "#/definitions/utils.Http"
                        }
                    },
                    "422": {
                        "description": "Server cannot process request data",
                        "schema": {
                            "$ref": "#/definitions/utils.Http"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/utils.Http"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.GetTokenResponce": {
            "type": "object",
            "properties": {
                "authorization_token": {
                    "type": "string"
                },
                "ttl": {
                    "type": "integer"
                }
            }
        },
        "handlers.ProcessPhotoResponce": {
            "type": "object",
            "properties": {
                "numberplates": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "utils.Http": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "metadata": {
                    "type": "string"
                },
                "statusCode": {
                    "type": "integer"
                }
            }
        }
    }
}